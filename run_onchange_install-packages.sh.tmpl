#!/bin/bash

if ! command -v yay > /dev/null; then
    echo "Installing Yay!"
    mkdir -p "$HOME/Clone"
    cd "$HOME/Clone" || exit
    sudo pacman -S --needed git base-devel
    git clone https://aur.archlinux.org/yay-bin.git
    cd yay-bin || exit
    makepkg -si
fi

yay -S --needed - << EOF
{{ range .packages.pacman -}} 
{{ . }}
{{ end -}}
EOF
