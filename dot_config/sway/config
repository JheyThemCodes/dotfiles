include ./exec

include $HOME/.cache/wal/colors-sway
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu rofi -show combi -theme launcher.rasi
## for_window [app_id="otter-launcher"] floating enable, resize set width 50 ppt
for_window [app_id="blueman-manager"] floating enable, resize set width 50 ppt height 50 ppt
for_window [app_id="zen" title="^Picture-in-Picture$"] floating enable, sticky enable
set $browser zen-browser
### Output configuration

include ./keybinds

### Input configuration
#
# Example configuration:
#
input type:touchpad {
    # Disable touchpad while typing
    dwt enabled
    tap enabled
    natural_scroll enabled
#    middle_emulation enabled
}
input type:pointer {
    natural_scroll enabled
}
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.


# Disable laptop screen when lid is closed (on=closed, off=open)
bindswitch lid:on exec lid-switch.sh disable 
bindswitch lid:off exec lid-switch.sh enable


gaps inner 5
smart_gaps on
default_border pixel 2
# for_window [app_id="kitty"] border normal 2
# Allow switching between workspaces with left and right swipes
bindgesture swipe:4:right workspace prev
bindgesture swipe:4:left workspace next
#

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    position top
    swaybar_command waybar 
    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*
