[global]
    monitor = 0
    follow = mouse
    width = (250, 500)
    height = (0, 750)
    offset = (17, 26)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color="#607566"
    font = Mononoki Nerd Font Mono 10,JetBrainsMono Nerd Font 10
    corner_radius = 5
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[urgency_low]
    foreground = "{background}"
    background = "{color11}"
    timeout = 3

[urgency_normal]
    foreground = "{background}"
    background = "{color11}"
    timeout = 5

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color1}"
    timeout = 15
